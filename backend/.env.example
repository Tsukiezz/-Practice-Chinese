# Set environment variables in your shell before starting the server.
DATABASE_PATH=hanzi_go.db
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8080
# Provider credentials are read on the server only. Never commit real values.
GEMINI_API_KEY=
# Fixed model used for grading. Keep the key only in backend/.env.
GEMINI_MODEL=gemini-3.5-flash
# Optional model used on overload, timeout, rate limit or missing primary model.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Backward-compatible fallback; normally leave this empty.
AI_API_KEY=

# Email OTP (Brevo / Gmail / Standard SMTP)
# --- Option 1: Brevo (Sendinblue) ---
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=your-brevo-login-email@example.com
# SMTP_PASSWORD=xsmtpsib-your-brevo-smtp-key
# SMTP_FROM=your-verified-sender-email@example.com
#
# --- Option 2: Gmail ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-16-character-gmail-app-password
# SMTP_FROM=your-email@gmail.com

