# Set environment variables in your shell before starting the server.
DATABASE_PATH=hanzi_go.db
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8080
# Provider credentials are read on the server only. Never commit real values.
GEMINI_API_KEY=
# Fixed model used for grading. Keep the key only in backend/.env.
GEMINI_MODEL=gemini-3.5-flash
# Optional model used on overload, timeout, rate limit or missing primary model.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Backward-compatible fallback; normally leave this empty.
AI_API_KEY=

# Email OTP (enable after obtaining an SMTP service)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=no-reply@example.com
# SMTP_USERNAME=
# SMTP_PASSWORD=
